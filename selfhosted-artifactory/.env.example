# Copy to selfhosted-artifactory/.env (gitignored).

# Password of the bundled PostgreSQL database, used by Artifactory only.
ARTIFACTORY_DB_PASSWORD=CHANGE-ME
# Admin password setup-repos.sh sets on the first run: 8+ characters with upper case,
# lower case and a digit, no quotes.
ARTIFACTORY_ADMIN_PASSWORD=CHANGE-ME

# ARTIFACTORY_VERSION=7.161.26
# ARTIFACTORY_MAX_HEAP=2g
