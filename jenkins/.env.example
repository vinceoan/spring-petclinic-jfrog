# Copy to jenkins/.env (gitignored).

JENKINS_ADMIN_PASSWORD=CHANGE-ME
JENKINS_PORT=8088
# Linux only: group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock)
# DOCKER_GID=999

# JFrog Cloud, required: platform URL (https://<name>.jfrog.io), your user name,
# and an identity or access token of that user.
JFROG_URL=
JFROG_USER=
JFROG_ACCESS_TOKEN=

# Self-hosted Artifactory, optional: the token is printed by
# selfhosted-artifactory/setup-repos.sh; leave it empty if you do not use it.
JFROG_SELFHOSTED_URL=http://artifactory:8082
JFROG_SELFHOSTED_USER=admin
JFROG_SELFHOSTED_TOKEN=

# What the job builds. Default: this clone, bind-mounted at /repo.
REPO_URL=file:///repo
REPO_BRANCH=main
